# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Flask
instance/
.webassets-cache

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Data (root folders of the desktop app only; git matches case-insensitively on
# macOS, so an unanchored `sessions/` would also hide ios/.../Views/Sessions/)
/exports/
/sessions/
*.csv
*.json
!manifest.json

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/

# iOS: the Xcode project is generated from ios/project.yml (xcodegen generate) and never tracked
ios/build*/
ios/*.xcodeproj/
# The `*.json` rule above must not hide asset catalogs or test fixtures
!ios/WattBench/**/*.json
!ios/WattBenchTests/**/*.json
.venv/
